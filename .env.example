# AutonomousAI Windows Configuration
# ALL MODEL DOWNLOADS, BROWSERS, AND CACHES ARE STRICTLY SAVED ON D: DRIVE

# Ollama Model Directory (Protects C: Drive)
OLLAMA_MODELS=D:\ollama_models
OLLAMA_HOST=http://127.0.0.1:11434

# Playwright Browser Binaries Location
PLAYWRIGHT_BROWSERS_PATH=D:\playwright_browsers

# HuggingFace & PyTorch Cache Directories
HF_HOME=D:\hf_cache
TORCH_HOME=D:\torch_cache
TRANSFORMERS_CACHE=D:\hf_cache

# Temporary Files Directory
TMPDIR=D:\tmp
TEMP=D:\tmp
TMP=D:\tmp

# Model Routing Configuration
MODEL_REASONING=qwen2.5:7b
MODEL_CODING=qwen2.5-coder:14b-instruct-q4_K_M
MODEL_FALLBACK=qwen2.5-coder:7b
MODEL_VISION=qwen2.5-vl

# Runtime & Execution Budgets
MAX_ITERATIONS=8
TIME_BUDGET_MINUTES=45
CONFIDENCE_THRESHOLD=0.90
EXECUTION_MODE=auto

# Workspace & Storage Paths
WORKSPACE_ROOT=d:\main projects\fullstackapplication\workspace
RUNTIME_DB_PATH=d:\main projects\fullstackapplication\runtime\state.db
METRICS_DB_PATH=d:\main projects\fullstackapplication\runtime\metrics.db
MEMORY_DIR=d:\main projects\fullstackapplication\memory
CACHE_DIR=d:\main projects\fullstackapplication\.cache
REPORTS_DIR=d:\main projects\fullstackapplication\reports
SCREENSHOTS_DIR=d:\main projects\fullstackapplication\screenshots
